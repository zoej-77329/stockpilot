# ==============================================================================
# StockPilot - Environment Configuration Template
# NOTE: Copy this file to '.env' for local development. Never commit real secrets.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=backend.wsgi:app
FLASK_ENV=development
PORT=5000

# Security Secrets (Generate random 32+ char strings in production)
SECRET_KEY=dev-insecure-flask-secret-key-change-in-production
JWT_SECRET_KEY=dev-insecure-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Database Connection URI
# Local Docker Postgres Default:
DATABASE_URL=postgresql://stockpilot_user:stockpilot_pass@localhost:5432/stockpilot

# Test Database Connection URI (defaults to in-memory SQLite if unset)
TEST_DATABASE_URL=sqlite:///:memory:

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
